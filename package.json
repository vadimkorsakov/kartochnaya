{
  "name": "kartochnaya-v045-baseline",
  "version": "0.0.0",
  "private": true,
  "description": "Development-only regression checks for the unchanged KARTOCHNAYA v0.45 release",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:known": "playwright test --project=known-failures",
    "test:all": "playwright test",
    "test:visual": "playwright test --project=chromium tests/visual.spec.js",
    "test:visual:record": "node scripts/record-baselines.mjs",
    "test:install": "node scripts/install-browser.mjs",
    "test:serve": "node scripts/test-server.mjs",
    "build": "node scripts/build.mjs",
    "build:html": "node scripts/build.mjs html",
    "build:pwa": "node scripts/build.mjs pwa",
    "test:unit": "node --test tests/colors.test.mjs tests/gradient-model.test.mjs tests/shape-catalog.test.mjs tests/geometry.test.mjs tests/indexeddb.test.mjs tests/project-integrity.test.mjs tests/zip-backup.test.mjs tests/workspace-replace.test.mjs",
    "test:source": "node --test tests/source-extraction.test.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "pretest": "npm run build",
    "pretest:all": "npm run build",
    "test:build": "npm run build && playwright test --project=chromium tests/build.spec.js",
    "test:bundle-smoke": "playwright test --project=standalone tests/module-bundle.smoke.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "pngjs": "7.0.0"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
